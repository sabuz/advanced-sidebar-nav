{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "advanced-sidebar-nav/nav",
	"version": "1.1.0",
	"title": "Advanced Sidebar Nav",
	"category": "widgets",
	"icon": "menu",
	"description": "Display navigation menus in sidebar with advanced styling options.",
	"attributes": {
		"menu": {
			"type": "string",
			"default": ""
		},
		"theme": {
			"type": "string",
			"default": "default"
		},
		"accentColor": {
			"type": "string",
			"default": "#dd102d"
		}
	},
	"supports": {
		"html": false,
		"spacing": {
			"margin": true,
			"padding": true
		}
	},
	"textdomain": "advanced-sidebar-nav",
	"editorScript": "file:./build/index.js",
	"editorStyle": "file:./build/index.css",
	"style": "file:./build/style-index.css",
	"render": "file:./render.php",
	"viewScript": "file:./build/view.js"
}
