{
	"name": "advanced-sidebar-nav",
	"version": "1.1.0",
	"description": "Advanced Sidebar Navigation Block",
	"author": "Nazmul Sabuz",
	"license": "GPL-2.0-or-later",
	"main": "block/build/index.js",
	"scripts": {
		"build": "wp-scripts build && npm run build:scss",
		"build:scss": "npx sass assets/style.scss assets/style.css --style=compressed --no-source-map",
		"dev": "concurrently \"wp-scripts start\" \"npm run dev:scss\"",
		"dev:scss": "npx sass assets/style.scss assets/style.css --watch --style=expanded --no-source-map",
		"lint:css": "wp-scripts lint-style",
		"lint:css:fix": "wp-scripts lint-style --fix",
		"lint:js": "wp-scripts lint-js",
		"lint:js:fix": "wp-scripts lint-js --fix",
		"packages-update": "wp-scripts packages-update"
	},
	"devDependencies": {
		"@wordpress/scripts": "^30.24.0",
		"concurrently": "^8.2.2"
	},
	"dependencies": {
		"@wordpress/api-fetch": "^7.31.0",
		"@wordpress/block-editor": "^15.4.0",
		"@wordpress/components": "^30.4.0",
		"@wordpress/data": "^10.31.0",
		"@wordpress/element": "^6.31.0",
		"@wordpress/i18n": "^6.4.0"
	}
}
